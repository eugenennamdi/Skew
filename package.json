{
  "name": "skew-fx-agent",
  "version": "2.0.0",
  "description": "Autonomous Dual-Oracle FX Market Maker & Cross-Venue Arbitrage Agent on Celo Mainnet (ERC-8004 #9905 / ERC-8021 celo_7935fb97e273)",
  "type": "module",
  "main": "skew-desk.mjs",
  "bin": {
    "skew-desk": "./skew-desk.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node skew-desk.mjs",
    "build": "node --check skew-desk.mjs && node --check test/skew-desk.test.mjs",
    "typecheck": "node --check skew-desk.mjs && node --check test/skew-desk.test.mjs",
    "demo": "node skew-desk.mjs --dry-run",
    "test": "node --test test/skew-desk.test.mjs",
    "check": "node skew-desk.mjs --check",
    "dry-run": "node skew-desk.mjs --dry-run",
    "test:rust": "cargo test --manifest-path textile-stitch/Cargo.toml --no-default-features --lib"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eugenennamdi/Skew.git"
  },
  "keywords": [
    "celo",
    "fx",
    "stablecoins",
    "textile-rfq",
    "uniswap-v3",
    "avellaneda-stoikov",
    "erc-8004",
    "erc-8021"
  ],
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
